{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.js --port 5173",
    "dev:customer": "vite --config vite.config.js --port 5173",
    "dev:operations": "vite --config vite.operations.config.js --port 5174",
    "build": "vite build && vite build --config vite.operations.config.js",
    "build:customer": "vite build --config vite.config.js --outDir dist-customer",
    "build:operations": "vite build --config vite.operations.config.js --outDir dist-operations && mv dist-operations/operations.html dist-operations/index.html",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0"
  }
}
